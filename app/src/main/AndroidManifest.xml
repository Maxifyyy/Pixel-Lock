<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PixelLock"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PixelLock">

        <!-- Hub: Make up / Life up -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home Up: Startbildschirm -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.PixelLock.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".HomeSettingsActivity" />

        <!-- ClockFace -->
        <activity android:name=".ClockSettingsActivity" />

        <!-- LockStar -->
        <activity android:name=".LockSettingsActivity" />
        <activity
            android:name=".LockClockActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".LockClockTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_lock"
            android:label="Sperr-Uhr"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- NotiStar -->
        <activity android:name=".NotiStarActivity" />
        <service
            android:name=".NotiListener"
            android:exported="true"
            android:label="PixelLock NotiStar"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Theme Park -->
        <activity android:name=".ThemeParkActivity" />

        <!-- Uhr-Widget -->
        <receiver
            android:name=".ClockWidgetProvider"
            android:exported="true"
            android:label="Uhr">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>
    </application>
</manifest>
